# Only needed if you build the optional leaderboards/cloud-save backend
# under infra/ — a purely offline game needs none of this.

DATABASE_URL=postgres://game:game@localhost:5432/game_backend
REDIS_URL=redis://localhost:6379

# Play Store release signing (used by .github/workflows/release.yml via CI
# secrets, never committed here as real values):
# ANDROID_KEYSTORE_BASE64=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
