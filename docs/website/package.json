{
  "name": "mobile-fortress-docs-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 documentation portal + interactive design hub for Mobile Fortress.",
  "scripts": {
    "prebuild": "node scripts/generate-nav.mjs && npm run build:astro",
    "predev": "node scripts/generate-nav.mjs",
    "dev": "vite",
    "build": "vue-tsc -b --noCheck && vite build",
    "build:astro": "astro build",
    "preview": "vite preview",
    "nuxt:dev": "nuxt dev",
    "nuxt:build": "nuxt build",
    "nuxt:generate": "nuxt generate",
    "nuxt:preview": "nuxt preview",
    "nuxt:prepare": "nuxt prepare",
    "lint": "eslint -c stack/eslint/eslint.config.js .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "cypress:open": "cypress open --config-file test/cypress/cypress.config.js",
    "cypress:run": "cypress run --config-file test/cypress/cypress.config.js",
    "cypress:e2e": "cypress run --config-file test/cypress/cypress.config.js --spec \"test/cypress/e2e/**/*.cy.js\"",
    "cypress:smoke": "cypress run --config-file test/cypress/cypress.config.js --spec \"test/cypress/smoke/**/*.cy.js\""
  },
  "dependencies": {
    "@tanstack/vue-form": "^1.33.4",
    "framer-motion": "^13.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.4.1",
    "nuxt": "^3.21.11",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuex": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/vue": "^8.1.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "astro": "^7.2.0",
    "autoprefixer": "^10.5.4",
    "cypress": "^15.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0"
  }
}
