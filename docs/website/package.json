{
  "name": "mobile-fortress-docs-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React documentation portal + interactive design hub for Mobile Fortress.",
  "scripts": {
    "prebuild": "node scripts/generate-nav.mjs && npm run gen:api && npm run build:astro && npm run build-storybook",
    "predev": "node scripts/generate-nav.mjs",
    "dev": "vite",
    "build": "tsc -b --noCheck && vite build",
    "postbuild": "node scripts/check-island-budgets.mjs",
    "check:budgets": "node scripts/check-island-budgets.mjs",
    "build:astro": "astro build || echo 'astro build failed — falling back to committed public/astro-island'",
    "gen:api": "typedoc && node scripts/fix-api-links.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o public/storybook || echo 'storybook build failed — falling back to committed public/storybook'",
    "preview": "vite preview",
    "next:dev": "next dev",
    "next:build": "next build",
    "lint": "eslint -c stack/eslint/eslint.config.js .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "cypress:open": "cypress open --config-file test/cypress/cypress.config.js",
    "cypress:run": "cypress run --config-file test/cypress/cypress.config.js",
    "cypress:e2e": "cypress run --config-file test/cypress/cypress.config.js --spec \"test/cypress/e2e/**/*.cy.js\"",
    "cypress:smoke": "cypress run --config-file test/cypress/cypress.config.js --spec \"test/cypress/smoke/**/*.cy.js\""
  },
  "dependencies": {
    "@apollo/client": "^3.13.0",
    "@tanstack/react-form": "^1.0.0",
    "aurelia": "^2.0.0-beta.26",
    "framer-motion": "^13.0.0",
    "graphql": "^16.9.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.4.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.1",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^4.7.0",
    "astro": "^7.2.0",
    "autoprefixer": "^10.5.4",
    "cypress": "^15.20.0",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.26",
    "storybook": "^10.5.7",
    "tailwindcss": "^3.4.19",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
