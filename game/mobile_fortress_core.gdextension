[configuration]

entry_symbol = "mobile_fortress_library_init"
compatibility_minimum = 4.2

[libraries]

; Desktop — local cmake build (see BUILD_CPP.md)
linux.debug.x86_64 = "res://bin/libmobile_fortress_core.linux.x86_64.so"
linux.release.x86_64 = "res://bin/libmobile_fortress_core.linux.x86_64.so"
windows.debug.x86_64 = "res://bin/libmobile_fortress_core.windows.x86_64.dll"
windows.release.x86_64 = "res://bin/libmobile_fortress_core.windows.x86_64.dll"
macos.debug = "res://bin/libmobile_fortress_core.macos.universal.dylib"
macos.release = "res://bin/libmobile_fortress_core.macos.universal.dylib"

; Android arm64 — scripts/build_android_gdextension.sh (NDK, 16 KB max page size).
android.debug.arm64 = "res://bin/libmobile_fortress_core.android.arm64.so"
android.release.arm64 = "res://bin/libmobile_fortress_core.android.arm64.so"

; iOS mapping is added when that dylib is built on macOS.
; Until then iOS exports use the classic GDScript fallback.
