#!/usr/bin/env bash
# Local git hook (install with `git config core.hooksPath git/hooks`, or rely
# on `pre-commit install` which manages `.git/hooks/pre-commit` directly).
#
# Fast, local-only checks before a commit is created. The full gate lives in
# .pre-commit-config.yaml / CI — this is a cheap first line of defense.
set -euo pipefail

if git diff --cached --name-only | grep -qE '\.(jks|keystore)$'; then
    echo "ERROR: refusing to commit a keystore file. Use local.properties / CI secrets instead." >&2
    exit 1
fi

if git diff --cached --name-only | grep -qE '^app/src/.*\.kt$'; then
    ./gradlew ktlintCheck -q
fi
