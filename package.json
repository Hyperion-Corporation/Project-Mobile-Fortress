{
  "name": "mobile-fortress",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile Fortress workspace root \u2014 npm workspaces for this repo's Node/TypeScript packages (currently docs/website, the documentation site + interactive design hub).",
  "workspaces": [
    "docs/website"
  ],
  "scripts": {
    "dev": "npm run dev --workspace docs/website",
    "build": "npm run build --workspace docs/website",
    "preview": "npm run preview --workspace docs/website",
    "site:dev": "npm run dev --workspace docs/website",
    "site:build": "npm run build --workspace docs/website",
    "site:preview": "npm run preview --workspace docs/website",
    "site:nav": "node docs/website/scripts/generate-nav.mjs",
    "next:dev": "npm run next:dev --workspace docs/website",
    "next:build": "npm run next:build --workspace docs/website"
  }
}
