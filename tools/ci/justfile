# tools/ci/justfile
# Recipes mirrored by .github/workflows/ci.yml — kept here so the exact same
# commands can be run locally before pushing.

set shell := ["bash", "-c"]
set working-directory := '../..'

cyan := '\033[0;36m'
green := '\033[0;32m'
reset := '\033[0m'

# Everything the "android" CI job runs on a pull request, in order
pr-gate:
    @echo -e "{{cyan}}Running Android PR gate: lint -> unit tests -> debug build...{{reset}}"
    just validation::check
    just test::unit
    just build::debug
    @echo -e "{{green}}✓ Android PR gate passed.{{reset}}"

# Everything the "ios" CI job runs on a pull request — macOS host only, see .devcontainer/README.md
pr-gate-ios:
    @echo -e "{{cyan}}Running iOS PR gate: analyze -> test...{{reset}}"
    just validation::ios-check
    just test::ios
    @echo -e "{{green}}✓ iOS PR gate passed.{{reset}}"

# Run pre-commit hooks against all files
pre-commit:
    pre-commit run --all-files
