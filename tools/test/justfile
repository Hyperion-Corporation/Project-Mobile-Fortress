# tools/test/justfile
# Unit + instrumented test recipes for both android/ and ios/.

set shell := ["bash", "-c"]
set working-directory := '../..'

cyan := '\033[0;36m'
reset := '\033[0m'

# --- Android ---

# Run unit tests (JVM, fast)
unit:
    @echo -e "{{cyan}}Running JVM unit tests (android/)...{{reset}}"
    ./gradlewtestDebugUnitTest

# Run instrumented tests on a connected device/emulator
instrumented:
    @echo -e "{{cyan}}Running instrumented tests on connected device/emulator (android/)...{{reset}}"
    ./gradlewconnectedDebugAndroidTest

# --- iOS ---
# Requires a macOS host with a booted/available simulator — see .devcontainer/README.md.

# Run the MyGame XCTest suite on a simulator
ios:
    @echo -e "{{cyan}}Running XCTest suite (ios/)...{{reset}}"
    xcodebuild -project ios/MyGame.xcodeproj -scheme MyGame \
        -destination 'platform=iOS Simulator,name=iPhone 15' test
